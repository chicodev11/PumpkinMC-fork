interface event {
    use common.{block-pos, game-mode, hand, position, click-type, nbt-tree};
    use item-stack.{item-stack};
    use enchantments.{enchantment};
    use damage-types.{damage-type};
    use screens.{screen};
    use player.{player, java-minecraft-version, bedrock-minecraft-version, merchant-trade};
    use text.{text-component};
    use %world.{%world, entity};
    use java-packets.{serverbound-packet as java-serverbound-packet, clientbound-packet as java-clientbound-packet};
    use bedrock-packets.{serverbound-packet as bedrock-serverbound-packet, clientbound-packet as bedrock-clientbound-packet};
    use uuid.{uuid};
    use java-dialogs.{dialog};

    variant serverbound-packet {
        java(java-serverbound-packet),
        bedrock(bedrock-serverbound-packet),
        unknown,
    }

    variant clientbound-packet {
        java(java-clientbound-packet),
        bedrock(bedrock-clientbound-packet),
        unknown,
    }

    enum event-priority {
        highest,
        high,
        normal,
        low,
        lowest,
    }

    /// An item stack written into a packet for one Java player: change `item` to change only
    /// what that client shows (client-side item names, lore, models). Fired only while a
    /// handler is registered, for every stack in every packet, so keep handlers quick.
    record client-item-view-event-data {
        player: player,
        item: item-stack,
    }

    /// A Java client's answer to `request-cookie`; no payload when it has no such cookie.
    record player-cookie-response-event-data {
        player: player,
        key: string,
        payload: option<list<u8>>,
    }

    record player-join-event-data {
        player: player,
        join-message: text-component,
        cancelled: bool
    }

    record player-leave-event-data {
        player: player,
        leave-message: text-component,
        cancelled: bool
    }

    /// A transfer request that a blocking handler can cancel or redirect.
    record player-transfer-event-data {
        player: player,
        host: string,
        port: u16,
        cancelled: bool
    }

    record player-login-event-data {
        player: player,
        kick-message: text-component,
        cancelled: bool
    }

    record player-chat-event-data {
        player: player,
        message: string,
        recipients: list<player>,
        signature: option<list<u8>>,
        cancelled: bool
    }

    record player-command-send-event-data {
        player: player,
        command: string,
        cancelled: bool
    }

    record player-permission-check-event-data {
        player: player,
        permission: string,
        permission-result: bool
    }

    record player-move-event-data {
        player: player,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record player-teleport-event-data {
        player: player,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record player-change-world-event-data {
        player: player,
        previous-world: %world,
        new-world: %world,
        position: position,
        yaw: f32,
        pitch: f32,
        cancelled: bool
    }

    record player-respawn-event-data {
        player: player,
        previous-world: %world,
        respawned-world: %world,
        position: position,
        yaw: f32,
        pitch: f32,
        alive: bool
    }

    record player-exp-change-event-data {
        player: player,
        amount: s32
    }

    record player-item-held-event-data {
        player: player,
        previous-slot: u8,
        new-slot: u8,
        cancelled: bool
    }

    record player-changed-main-hand-event-data {
        player: player,
        main-hand: hand
    }

    record player-gamemode-change-event-data {
        player: player,
        previous-gamemode: game-mode,
        new-gamemode: game-mode,
        cancelled: bool
    }

    record player-custom-payload-event-data {
        player: player,
        channel: string,
        data: list<u8>
    }

    enum player-fish-state {
        fishing,
        caught-fish,
        caught-entity,
        in-ground,
        failed-attempt,
        reel-in,
        bite,
    }

    record player-fish-event-data {
        player: player,
        caught-uuid: option<uuid>,
        caught-type: string,
        hook-uuid: uuid,
        state: player-fish-state,
        hand: hand,
        exp-to-drop: s32,
        cancelled: bool
    }

    record player-egg-throw-event-data {
        player: player,
        egg-uuid: uuid,
        hatching: bool,
        num-hatches: u8,
        hatching-type: string,
        cancelled: bool
    }

    enum entity-interaction-action {
        interact,
        attack,
        interact-at,
    }

    enum interact-action {
        left-click-block,
        left-click-air,
        right-click-air,
        right-click-block,
    }

    record player-interact-event-data {
        player: player,
        action: interact-action,
        clicked-pos: option<block-pos>,
        block: string,
        /// The hand that interacted (Bukkit `getHand`): a right click comes once per hand the
        /// client tries (main first, the off hand only when the main hand did nothing), so
        /// filter on it to handle a click once. Left clicks are always the main hand.
        hand: hand,
        cancelled: bool
    }

    record player-toggle-sneak-event-data {
        player: player,
        is-sneaking: bool,
        cancelled: bool
    }

    record player-toggle-flight-event-data {
        player: player,
        is-flying: bool,
        cancelled: bool
    }

    record player-toggle-sprint-event-data {
        player: player,
        is-sprinting: bool,
        cancelled: bool
    }

    record player-interact-unknown-entity-event-data {
        player: player,
        entity-id: s32,
        action: entity-interaction-action,
        cancelled: bool
    }

    record inventory-click-event-data {
        player: player,
        window-type: option<screen>,
        click-type: click-type,
        slot: s16,
        raw-slot: s16,
        clicked-item: option<item-stack>,
        cursor: option<item-stack>,
        hotbar-button: s32,
        cancelled: bool
    }

    record inventory-close-event-data {
        player: player,
        window-type: option<screen>
    }

    record block-redstone-event-data {
        target-world: %world,
        state-id: u16,
        block-pos: block-pos,
        old-current: s32,
        new-current: s32,
        cancelled: bool
    }

    record block-break-event-data {
        player: option<player>,
        block: string,
        block-pos: block-pos,
        exp: u32,
        should-drop: bool,
        cancelled: bool
    }

    record block-burn-event-data {
        igniting-block: string,
        block: string,
        block-pos: block-pos,
        target-world: %world,
        cancelled: bool
    }

    record block-can-build-event-data {
        block-to-build: string,
        buildable: bool,
        player: player,
        block: string,
        cancelled: bool
    }

    record block-grow-event-data {
        target-world: %world,
        old-block: string,
        old-state-id: u16,
        new-block: string,
        new-state-id: u16,
        block-pos: block-pos,
        cancelled: bool
    }

    record block-place-event-data {
        player: player,
        block-placed: string,
        block-placed-against: string,
        block-pos: block-pos,
        can-build: bool,
        cancelled: bool
    }

    record bedrock-form-response-event-data {
        player: player,
        form-id: u32,
        response-data: option<string>,
    }

    record dialog-click-action-event-data {
        player: player,
        id: string,
        /// The payload as network NBT bytes.
        payload: option<list<u8>>,
        /// The payload parsed: for `dynamic-custom` a compound of input key -> value.
        /// Read-only.
        payload-nbt: option<nbt-tree>,
        cancelled: bool,
    }

    record dialog-show-event-data {
        player: player,
        dialog: dialog,
        cancelled: bool,
    }

    record dialog-clear-event-data {
        player: player,
        cancelled: bool,
    }

    record server-command-event-data {
        command: string,
        cancelled: bool
    }

    record server-list-ping-address {
        host: string,
        port: u16
    }

    record server-list-ping-event-data {
        hostname: string,
        address: server-list-ping-address,
        motd: text-component,
        max-players: u32,
        num-players: u32,
        favicon: option<string>
    }

    enum server-load-type {
        startup,
        reload,
    }

    record server-load-event-data {
        load-type: server-load-type
    }

    record spawn-change-event-data {
        target-world: %world,
        previous-position: block-pos,
        previous-yaw: f32,
        previous-pitch: f32,
        new-position: block-pos,
        new-yaw: f32,
        new-pitch: f32
    }

    record server-broadcast-event-data {
        message: text-component,
        sender: text-component,
        cancelled: bool
    }

    record server-tick-start-event-data {
        tick: s32
    }

    record server-tick-end-event-data {
        tick: s32,
        duration-nanos: s64
    }

    record packet-received-event-data {
        player: player,
        packet: serverbound-packet,
        packet-id: s32,
        raw-payload: list<u8>,
        cancelled: bool
    }

    /// A packet already in the client's format.
    record raw-packet {
        packet-id: s32,
        payload: list<u8>,
    }

    record packet-sent-event-data {
        player: player,
        packet: clientbound-packet,
        packet-id: s32,
        raw-payload: list<u8>,
        /// Sent right after this packet, even when it is cancelled.
        extra-packets: list<raw-packet>,
        cancelled: bool
    }

    enum java-connection-state {
        handshake,
        status,
        login,
        config,
        play,
    }

    record java-connection-packet-received-event-data {
        connection-id: u64,
        version: java-minecraft-version,
        state: java-connection-state,
        packet-id: s32,
        raw-payload: list<u8>,
        cancelled: bool
    }

    record java-connection-packet-sent-event-data {
        connection-id: u64,
        version: java-minecraft-version,
        state: java-connection-state,
        packet-id: s32,
        raw-payload: list<u8>,
        extra-packets: list<raw-packet>,
        cancelled: bool
    }

    record bedrock-connection-packet-received-event-data {
        connection-id: u64,
        protocol-version: u32,
        version: bedrock-minecraft-version,
        packet-id: s32,
        raw-payload: list<u8>,
        cancelled: bool
    }

    record bedrock-connection-packet-sent-event-data {
        connection-id: u64,
        protocol-version: u32,
        version: bedrock-minecraft-version,
        packet-id: s32,
        raw-payload: list<u8>,
        extra-packets: list<raw-packet>,
        cancelled: bool
    }

    record player-interact-entity-event-data {
        player: player,
        entity-id: s32,
        action: entity-interaction-action,
        sneaking: bool,
        cancelled: bool
    }

    record chunk-load-event-data {
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record chunk-save-event-data {
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record chunk-send-event-data {
        target-world: %world,
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record entity-damage-event-data {
        entity-id: s32,
        /// The entity taking damage (Bukkit `getEntity`). Read-only.
        entity: option<entity>,
        damage: f32,
        damage-type: damage-type,
        /// What hit it (Paper `getDamageSource().getDirectEntity()`): an arrow or the attacker.
        /// Read-only.
        direct-entity-id: option<s32>,
        /// Who is responsible (`getDamageSource().getCausingEntity()`): a projectile's shooter.
        /// Read-only.
        causing-entity-id: option<s32>,
        cancelled: bool
    }

    record entity-death-event-data {
        entity-id: s32,
        /// The entity that died (Bukkit `getEntity`). Read-only.
        entity: entity,
        /// What killed it (Paper `getDamageSource`). Read-only.
        damage-type: damage-type,
        /// The entity that hit directly (`DamageSource.getDirectEntity`): an arrow or the attacker.
        direct-entity-id: option<s32>,
        /// The entity responsible (`DamageSource.getCausingEntity`): a projectile's shooter.
        causing-entity-id: option<s32>,
        dropped-exp: s32,
        /// What the entity drops (loot, equipment, inventory); plugins may change the list.
        drops: list<item-stack>
    }

    record player-death-event-data {
        player: player,
        death-message: text-component,
        dropped-exp: s32,
        keep-inventory: bool,
        cancelled: bool
    }

    record entity-spawn-event-data {
        entity-id: s32,
        /// The entity about to be added (Bukkit `getEntity`). Read-only.
        entity: entity,
        /// The entity type's numeric registry id, as a string.
        entity-type: string,
        position: position,
        target-world: %world,
        cancelled: bool
    }

    record entity-combust-event-data {
        entity-id: s32,
        duration-secs: f32,
        /// Why it caught fire: "sunlight", "lava", "fire", "lightning", "projectile", "attack"
        /// or "other". Read-only.
        cause: string,
        cancelled: bool
    }

    record entity-regain-health-event-data {
        entity-id: s32,
        amount: f32,
        cancelled: bool
    }

    record entity-air-change-event-data {
        entity-id: s32,
        amount: s32,
        cancelled: bool
    }

    record entity-breed-event-data {
        father-id: s32,
        mother-id: s32,
        child-id: s32,
        experience: s32,
        cancelled: bool
    }

    record entity-dismount-event-data {
        entity-id: s32,
        dismounted-id: s32,
        cancelled: bool
    }

    record entity-dye-event-data {
        entity-id: s32,
        color: string,
        player: option<player>,
        cancelled: bool
    }

    record entity-enter-love-mode-event-data {
        entity-id: s32,
        human-entity-id: option<s32>,
        ticks-in-love: s32,
        cancelled: bool
    }

    record entity-explode-event-data {
        entity-id: s32,
        position: position,
        yield-rate: f32,
        cancelled: bool
    }

    record entity-mount-event-data {
        entity-id: s32,
        mounted-id: s32,
        cancelled: bool
    }

    record entity-pickup-item-event-data {
        entity-id: s32,
        item-name: string,
        count: u8,
        cancelled: bool
    }

    record entity-portal-event-data {
        entity-id: s32,
        portal-pos: block-pos,
        cancelled: bool
    }

    record entity-resurrect-event-data {
        entity-id: s32,
        cancelled: bool
    }

    record entity-shoot-bow-event-data {
        entity-id: s32,
        weapon-name: string,
        force: f32,
        cancelled: bool
    }

    record entity-tame-event-data {
        entity-id: s32,
        owner: player,
        cancelled: bool
    }

    enum target-reason {
        closest-player,
        closest-entity,
        random-target,
        target-attacked-entity,
        target-attacked-nearby-entity,
        target-attacked-owner,
        owner-attacked-target,
        pig-zombie-target,
        angry,
        forgot-target,
        fleeing,
        unknown,
    }

    record entity-target-event-data {
        entity-id: s32,
        target-id: option<s32>,
        reason: target-reason,
        cancelled: bool
    }

    record entity-teleport-event-data {
        entity-id: s32,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record entity-toggle-glide-event-data {
        entity-id: s32,
        is-gliding: bool,
        cancelled: bool
    }

    record entity-transform-event-data {
        entity-id: s32,
        new-entity-id: s32,
        transform-reason: string,
        cancelled: bool
    }

    record creature-spawn-event-data {
        entity-id: s32,
        /// The creature about to be added (Bukkit `getEntity`). Read-only.
        entity: entity,
        entity-type: string,
        position: position,
        target-world: %world,
        spawn-reason: string,
        player: option<player>,
        cancelled: bool
    }

    record ender-dragon-change-phase-event-data {
        entity-id: s32,
        current-phase: string,
        new-phase: string,
        cancelled: bool
    }

    record entity-break-door-event-data {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-change-block-event-data {
        entity-id: s32,
        block-pos: block-pos,
        new-block: string,
        cancelled: bool
    }

    record entity-damage-by-block-event-data {
        entity-id: s32,
        damager-pos: option<block-pos>,
        damage: f32,
        cause: string,
        cancelled: bool
    }

    record entity-damage-by-entity-event-data {
        entity-id: s32,
        /// The entity that hit directly (Bukkit `getDamager`): the attacker, or the arrow or
        /// other projectile.
        damager-id: s32,
        /// The entity responsible (`DamageSource.getCausingEntity`): a projectile's shooter or
        /// the melee attacker; none for an ownerless projectile.
        causing-entity-id: option<s32>,
        damage: f32,
        damage-type: damage-type,
        /// The damage type's debug name (kept for older plugins).
        cause: string,
        /// The weapon used (`DamageSource.getWeaponItem`): the causing entity's main hand item.
        weapon: option<item-stack>,
        /// The entity taking damage (Bukkit `getEntity`). Read-only.
        entity: option<entity>,
        cancelled: bool
    }

    record entity-drop-item-event-data {
        entity-id: s32,
        item-name: string,
        count: u8,
        cancelled: bool
    }

    record entity-enter-block-event-data {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-exhaustion-event-data {
        entity-id: s32,
        exhaustion: f32,
        cancelled: bool
    }

    record entity-interact-event-data {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-knockback-event-data {
        entity-id: s32,
        hit-by-id: option<s32>,
        knockback: position,
        cancelled: bool
    }

    record entity-place-event-data {
        entity-id: s32,
        block-pos: block-pos,
        block-name: string,
        cancelled: bool
    }

    record entity-pose-change-event-data {
        entity-id: s32,
        pose: string,
        cancelled: bool
    }

    record entity-potion-effect-event-data {
        entity-id: s32,
        effect-name: string,
        duration: s32,
        amplifier: u8,
        cancelled: bool
    }

    record entity-spell-cast-event-data {
        entity-id: s32,
        spell: string,
        cancelled: bool
    }

    record entity-target-living-entity-event-data {
        entity-id: s32,
        target-id: option<s32>,
        reason: string,
        cancelled: bool
    }

    record entity-toggle-sit-event-data {
        entity-id: s32,
        sitting: bool,
        cancelled: bool
    }

    record entity-toggle-swim-event-data {
        entity-id: s32,
        is-swimming: bool,
        cancelled: bool
    }

    record explosion-prime-event-data {
        entity-id: s32,
        radius: f32,
        fire: bool,
        cancelled: bool
    }

    record firework-explode-event-data {
        entity-id: s32,
        cancelled: bool
    }

    record food-level-change-event-data {
        entity-id: s32,
        food-level: u8,
        cancelled: bool
    }

    record item-despawn-event-data {
        entity-id: s32,
        cancelled: bool
    }

    record item-merge-event-data {
        entity-id: s32,
        target-id: s32,
        cancelled: bool
    }

    record item-spawn-event-data {
        entity-id: s32,
        position: position,
        item-name: string,
        cancelled: bool
    }

    record piglin-barter-event-data {
        entity-id: s32,
        input-item: item-stack,
        outcome: list<item-stack>,
        cancelled: bool
    }

    record projectile-hit-event-data {
        entity-id: s32,
        hit-position: position,
        hit-entity-id: option<s32>,
        cancelled: bool
    }

    record projectile-launch-event-data {
        entity-id: s32,
        shooter-id: option<s32>,
        cancelled: bool
    }

    record sheep-dye-wool-event-data {
        entity-id: s32,
        dye-color: u8,
        player-id: option<s32>,
        cancelled: bool
    }

    record sheep-regrow-wool-event-data {
        entity-id: s32,
        cancelled: bool
    }

    record slime-split-event-data {
        entity-id: s32,
        count: s32,
        cancelled: bool
    }

    record strider-temperature-change-event-data {
        entity-id: s32,
        is-shivering: bool,
        cancelled: bool
    }

    record villager-acquire-trade-event-data {
        entity-id: s32,
        recipe-index: s32,
        cancelled: bool
    }

    record villager-career-change-event-data {
        entity-id: s32,
        profession: string,
        reason: string,
        cancelled: bool
    }

    record villager-replenish-trade-event-data {
        entity-id: s32,
        restock-quantity: s32,
        cancelled: bool
    }

    record warden-anger-change-event-data {
        entity-id: s32,
        target-id: s32,
        old-anger: s32,
        new-anger: s32,
        cancelled: bool
    }

    record area-effect-cloud-apply-event-data {
        entity-id: s32,
        affected-entities: list<s32>,
        cancelled: bool
    }

    record arrow-body-count-change-event-data {
        entity-id: s32,
        old-amount: u32,
        new-amount: u32,
        cancelled: bool
    }

    record bat-toggle-sleep-event-data {
        entity-id: s32,
        is-awake: bool,
        cancelled: bool
    }

    record creeper-power-event-data {
        entity-id: s32,
        lightning-id: option<s32>,
        cause: string,
        cancelled: bool
    }

    record entity-combust-by-block-event-data {
        entity-id: s32,
        combuster: block-pos,
        duration: f32,
        cancelled: bool
    }

    record entity-combust-by-entity-event-data {
        entity-id: s32,
        combuster-id: s32,
        duration: f32,
        cancelled: bool
    }

    record entity-knockback-by-entity-event-data {
        entity-id: s32,
        hit-by-id: s32,
        force: f64,
        x: f64,
        y: f64,
        z: f64,
        cancelled: bool
    }

    record entity-portal-enter-event-data {
        entity-id: s32,
        location: block-pos,
        cancelled: bool
    }

    record entity-portal-exit-event-data {
        entity-id: s32,
        from-pos: block-pos,
        to-pos: option<block-pos>,
        cancelled: bool
    }

    record entity-remove-event-data {
        entity-id: s32,
        cause: string,
        cancelled: bool
    }

    record entity-target-block-event-data {
        entity-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record entity-unleash-event-data {
        entity-id: s32,
        reason: string,
        cancelled: bool
    }

    record exp-bottle-event-data {
        entity-id: s32,
        experience: s32,
        location: block-pos,
        show-effect: bool,
        cancelled: bool
    }

    record horse-jump-event-data {
        entity-id: s32,
        power: f32,
        cancelled: bool
    }

    record lingering-potion-splash-event-data {
        entity-id: s32,
        location: block-pos,
        potion-item: string,
        cancelled: bool
    }

    record pig-zap-event-data {
        entity-id: s32,
        lightning-id: s32,
        pig-zombie-id: s32,
        cancelled: bool
    }

    record pig-zombie-anger-event-data {
        entity-id: s32,
        target-id: option<s32>,
        new-anger: s32,
        cancelled: bool
    }

    record potion-splash-event-data {
        entity-id: s32,
        location: block-pos,
        potion-item: string,
        affected-entities: list<s32>,
        cancelled: bool
    }

    record spawner-spawn-event-data {
        entity-id: s32,
        spawner-pos: block-pos,
        cancelled: bool
    }

    record trial-spawner-spawn-event-data {
        entity-id: s32,
        spawner-pos: block-pos,
        cancelled: bool
    }

    record villager-reputation-change-event-data {
        entity-id: s32,
        target-id: s32,
        reputation-change: s32,
        cancelled: bool
    }

    record player-item-consume-event-data {
        player: player,
        item-name: string,
        cancelled: bool
    }

    record player-item-damage-event-data {
        player: player,
        item-name: string,
        damage: s32,
        cancelled: bool
    }

    record player-drop-item-event-data {
        player: player,
        item-name: string,
        count: u8,
        cancelled: bool
    }

    record player-bed-enter-event-data {
        player: player,
        bed-pos: block-pos,
        cancelled: bool
    }

    record player-bed-leave-event-data {
        player: player,
        bed-pos: block-pos
    }

    record player-bucket-empty-event-data {
        player: player,
        block-pos: block-pos,
        bucket: string,
        cancelled: bool
    }

    record player-bucket-fill-event-data {
        player: player,
        block-pos: block-pos,
        bucket: string,
        cancelled: bool
    }

    record async-player-chat-event-data {
        player: player,
        message: string,
        format: text-component,
        cancelled: bool
    }

    record async-player-pre-login-event-data {
        player-name: string,
        player-uuid: string,
        ip-address: string,
        kick-message: text-component,
        cancelled: bool
    }

    record player-advancement-done-event-data {
        player: player,
        advancement-id: string,
        cancelled: bool
    }

    record player-animation-event-data {
        player: player,
        animation-type: string,
        cancelled: bool
    }

    record player-armor-stand-manipulate-event-data {
        player: player,
        armor-stand-id: s32,
        slot: u8,
        cancelled: bool
    }

    record player-bucket-entity-event-data {
        player: player,
        entity-id: s32,
        bucket-item: string,
        cancelled: bool
    }

    record player-changed-world-event-data {
        player: player,
        from-world: %world,
        to-world: %world,
        cancelled: bool
    }

    record player-channel-event-data {
        player: player,
        channel: string,
        cancelled: bool
    }

    record player-command-preprocess-event-data {
        player: player,
        command: string,
        cancelled: bool
    }

    record player-edit-book-event-data {
        player: player,
        slot: u32,
        pages: list<string>,
        title: option<string>,
        signing: bool,
        cancelled: bool
    }

    record player-elytra-boost-event-data {
        player: player,
        firework-id: s32,
        cancelled: bool
    }

    record player-exp-cooldown-change-event-data {
        player: player,
        new-cooldown: s32,
        cancelled: bool
    }

    /// Paper `PlayerJumpEvent`. Cancelling sends the player back to `from-position`.
    record player-jump-event-data {
        player: player,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    /// Paper `PlayerPickupExperienceEvent`, fired before the pickup cooldown starts.
    record player-pickup-experience-event-data {
        player: player,
        orb: entity,
        /// The experience one pickup of the orb gives. Read-only.
        experience: s32,
        cancelled: bool
    }

    /// Paper `PlayerPostRespawnEvent`: the respawn has finished. Read-only.
    record player-post-respawn-event-data {
        player: player,
        respawned-world: %world,
        position: position,
        yaw: f32,
        pitch: f32
    }

    /// Paper `PlayerTrackEntityEvent`. Cancelling skips the spawn packets; the player still
    /// counts as tracking the entity.
    record player-track-entity-event-data {
        player: player,
        entity: entity,
        cancelled: bool
    }

    /// Paper `PlayerUntrackEntityEvent`: out of range or removed. Read-only.
    record player-untrack-entity-event-data {
        player: player,
        entity: entity
    }

    /// Paper `EntityAddToWorldEvent`: spawned or loaded with its chunk. Read-only.
    record entity-add-to-world-event-data {
        entity: entity,
        entity-world: %world
    }

    /// Paper `EntityRemoveFromWorldEvent`: removed or unloaded with its chunk. Read-only.
    record entity-remove-from-world-event-data {
        entity: entity,
        entity-world: %world
    }

    /// Paper `EntityMoveEvent`: a living entity other than a player moved or turned this tick.
    /// Cancelling puts it back at `from-position`; a changed `to-position`/rotation moves it there.
    record entity-move-event-data {
        entity: entity,
        from-position: position,
        from-yaw: f32,
        from-pitch: f32,
        to-position: position,
        to-yaw: f32,
        to-pitch: f32,
        cancelled: bool
    }

    /// Paper `PrePlayerAttackEntityEvent`. `will-attack` is false when vanilla would skip the
    /// attack (experience orbs, interaction entities without `response`). Cancelling stops it.
    record pre-player-attack-entity-event-data {
        player: player,
        attacked: entity,
        will-attack: bool,
        cancelled: bool
    }

    /// Paper `PlayerStopUsingItemEvent`: the player let go of an item in use. Read-only.
    record player-stop-using-item-event-data {
        player: player,
        item: item-stack,
        ticks-held-for: s32
    }

    /// Paper `PlayerItemGroupCooldownEvent`: a cooldown group is about to start. Change `cooldown` (ticks) or cancel.
    record player-item-group-cooldown-event-data {
        player: player,
        cooldown-group: string,
        cooldown: s32,
        cancelled: bool
    }

    /// Paper `PlayerItemCooldownEvent`: an item's use starts a cooldown. Change `cooldown` (ticks) or cancel.
    record player-item-cooldown-event-data {
        player: player,
        item-type: string,
        cooldown-group: string,
        cooldown: s32,
        cancelled: bool
    }

    /// Paper `PlayerLaunchProjectileEvent`: a player throws a projectile item (snowball, egg, ender pearl,
    /// experience bottle, splash/lingering potion, wind charge, trident). Cancel to stop the throw.
    record player-launch-projectile-event-data {
        player: player,
        item: item-stack,
        projectile: entity,
        should-consume: bool,
        cancelled: bool
    }

    /// Paper `PlayerStartSpectatingEntityEvent`: a spectator starts viewing through an entity.
    record player-start-spectating-entity-event-data {
        player: player,
        current-spectator-target: entity,
        new-spectator-target: entity,
        cancelled: bool
    }

    /// Paper `PlayerStopSpectatingEntityEvent`: a spectator stops viewing through an entity.
    record player-stop-spectating-entity-event-data {
        player: player,
        spectator-target: entity,
        cancelled: bool
    }

    /// Paper `PlayerAttackEntityCooldownResetEvent`: an attack resets the attack charge. Cancel to keep it.
    record player-attack-entity-cooldown-reset-event-data {
        player: player,
        attacked: entity,
        cooldown: f32,
        cancelled: bool
    }

    /// Paper `PlayerArmorChangeEvent`: an armor slot changed. Read-only.
    record player-armor-change-event-data {
        player: player,
        slot: string,
        old-item: item-stack,
        new-item: item-stack
    }

    /// Paper `PlayerDeepSleepEvent`: the player has slept long enough to count for skipping the night.
    /// Cancelling restarts the sleep count.
    record player-deep-sleep-event-data {
        player: player,
        cancelled: bool
    }

    /// Paper `PlayerShieldDisableEvent`: an attack disables the player's shield. Change `cooldown` or cancel.
    record player-shield-disable-event-data {
        player: player,
        damager: option<entity>,
        cooldown: s32,
        cancelled: bool
    }

    /// Paper `PlayerArmSwingEvent`: the player swings a hand (`HAND` or `OFF_HAND`).
    record player-arm-swing-event-data {
        player: player,
        hand: string,
        cancelled: bool
    }

    /// Paper `ClientTickEndEvent`: the client finished a tick. Keep handlers quick.
    record client-tick-end-event-data {
        player: player
    }

    /// Paper `PlayerClientOptionsChangeEvent`: the client sent its options, before they apply. Read-only.
    record player-client-options-change-event-data {
        player: player,
        locale: string,
        view-distance: s32,
        chat-visibility: string,
        chat-colors: bool,
        skin-parts: s32,
        main-hand: string,
        text-filtering: bool,
        allow-server-listings: bool
    }

    /// Paper `PlayerSwapWithEquipmentSlotEvent`: right-clicking equips the held item (armor, elytra, heads).
    record player-swap-with-equipment-slot-event-data {
        player: player,
        hand: string,
        slot: string,
        item: item-stack,
        cancelled: bool
    }

    /// Paper `PlayerMapFilledEvent`: an empty map was used. Change `created-map` to give another item.
    record player-map-filled-event-data {
        player: player,
        original-item: item-stack,
        created-map: item-stack
    }

    /// Paper `PlayerFlowerPotManipulateEvent`: a plant goes into (`placing`) or out of a flower pot.
    record player-flower-pot-manipulate-event-data {
        player: player,
        flowerpot: block-pos,
        item: item-stack,
        placing: bool,
        cancelled: bool
    }

    /// Paper `PlayerConnectionCloseEvent`: a joined player's connection closed. Read-only.
    record player-connection-close-event-data {
        player-uuid: string,
        player-name: string
    }

    /// Paper `PlayerItemFrameChangeEvent`: a player puts an item into (`PLACE`) or turns (`ROTATE`) an item frame.
    record player-item-frame-change-event-data {
        player: player,
        item-frame: entity,
        item: item-stack,
        action: string,
        cancelled: bool
    }

    /// Paper `PlayerReadyArrowEvent`: a bow or crossbow picks an arrow. Cancel to skip it (the next is tried).
    record player-ready-arrow-event-data {
        player: player,
        bow: item-stack,
        arrow: item-stack,
        cancelled: bool
    }

    /// Paper `AnvilDamagedEvent`: using an anvil damages it. `damage-state` is FULL, CHIPPED, DAMAGED or BROKEN.
    record anvil-damaged-event-data {
        player: player,
        block: block-pos,
        damage-state: string,
        cancelled: bool
    }

    /// Paper `CreeperIgniteEvent`: a creeper is lit with flint and steel.
    record creeper-ignite-event-data {
        creeper: entity,
        ignited: bool,
        cancelled: bool
    }

    /// Paper `PufferFishStateChangeEvent`: a pufferfish puffs up or down (0 small, 1 mid, 2 full).
    record puffer-fish-state-change-event-data {
        pufferfish: entity,
        new-puff-state: s32,
        cancelled: bool
    }

    /// Paper `EndermanAttackPlayerEvent`: an enderman checks whether a player stares at it. Change `should-attack`.
    record enderman-attack-player-event-data {
        enderman: entity,
        player: player,
        should-attack: bool
    }

    /// Paper `ThrownEggHatchEvent`: a thrown egg broke. Change `hatching` or `num-hatches`.
    record thrown-egg-hatch-event-data {
        egg: entity,
        hatching: bool,
        num-hatches: s32,
        hatching-type: string
    }

    /// Paper `ElderGuardianAppearanceEvent`: an elder guardian curses a player (the face and mining fatigue).
    record elder-guardian-appearance-event-data {
        guardian: entity,
        affected-player: player,
        cancelled: bool
    }

    /// Paper `EntityJumpEvent`: a living entity other than a player jumps.
    record entity-jump-event-data {
        entity: entity,
        cancelled: bool
    }

    /// Paper `ExperienceOrbMergeEvent`: one experience orb absorbs another.
    record experience-orb-merge-event-data {
        merge-target: entity,
        merge-source: entity,
        cancelled: bool
    }

    /// Paper `EntityPathfindEvent`: a mob starts finding a path to `location`.
    record entity-pathfind-event-data {
        entity: entity,
        location: position,
        target-entity: option<entity>,
        cancelled: bool
    }

    /// Paper `EntityInsideBlockEvent`: an entity is inside a block that acts on it (fire, cobweb, portals...).
    /// Fired every tick while inside, so keep handlers quick.
    record entity-inside-block-event-data {
        entity: entity,
        block: block-pos,
        cancelled: bool
    }

    /// Paper `SkeletonHorseTrapEvent`: a skeleton trap horse is set off by nearby players.
    record skeleton-horse-trap-event-data {
        horse: entity,
        eligible-players: list<entity>,
        cancelled: bool
    }

    /// Paper `EntityLoadCrossbowEvent`: a crossbow is loaded. Set `consume-item` to false to keep the ammo.
    record entity-load-crossbow-event-data {
        entity: player,
        crossbow: item-stack,
        hand: string,
        consume-item: bool,
        cancelled: bool
    }

    /// Paper `BeaconEffectEvent`: a beacon gives a player its effect. Change the effect or cancel.
    record beacon-effect-event-data {
        block: block-pos,
        player: player,
        effect-type: string,
        amplifier: s32,
        duration: s32,
        is-primary: bool,
        cancelled: bool
    }

    /// Paper `BeaconActivatedEvent`: a beacon got a valid base.
    record beacon-activated-event-data {
        block: block-pos,
        levels: s32
    }

    /// Paper `BeaconDeactivatedEvent`: a beacon lost its base.
    record beacon-deactivated-event-data {
        block: block-pos
    }

    /// Paper `TargetHitEvent`: a projectile hit a target block. Change `signal-strength` (0-15) or cancel.
    record target-hit-event-data {
        projectile: entity,
        block: block-pos,
        signal-strength: s32,
        cancelled: bool
    }

    /// Paper `BlockPreDispenseEvent`: a dispenser picked the item in `slot` and is about to dispense it.
    record block-pre-dispense-event-data {
        block: block-pos,
        item: item-stack,
        slot: s32,
        cancelled: bool
    }

    /// Paper `BlockFailedDispenseEvent`: a dispenser or dropper was powered while empty.
    record block-failed-dispense-event-data {
        block: block-pos,
        should-play-effect: bool
    }

    /// Paper `VaultChangeStateEvent`: a vault changes state (INACTIVE, ACTIVE, UNLOCKING, EJECTING).
    record vault-change-state-event-data {
        block: block-pos,
        current-state: string,
        new-state: string,
        cancelled: bool
    }

    /// Paper `BlockBreakProgressUpdateEvent`: the crack progress (0-1) shown on a block changed.
    record block-break-progress-update-event-data {
        block: block-pos,
        progress: f32,
        entity: option<entity>
    }

    /// Paper `DragonEggFormEvent`: the dragon egg appears after the first dragon kill.
    record dragon-egg-form-event-data {
        block: block-pos,
        cancelled: bool
    }

    /// Paper `BellRevealRaiderEvent`: a ringing bell makes a raider glow.
    record bell-reveal-raider-event-data {
        block: block-pos,
        entity: entity,
        cancelled: bool
    }

    /// Paper `WorldDifficultyChangeEvent`: the difficulty changed. Read-only.
    record world-difficulty-change-event-data {
        event-world: %world,
        difficulty: string
    }

    /// Paper `WorldGameRuleChangeEvent`: a game rule is about to change. Change `value` or cancel.
    record world-game-rule-change-event-data {
        event-world: %world,
        game-rule: string,
        value: string,
        cancelled: bool
    }

    /// Paper `ServerResourcesReloadedEvent`: datapacks were reloaded.
    record server-resources-reloaded-event-data {
        cause: string
    }

    /// A player fails to get into a bed (Paper `PlayerBedFailEnterEvent`). Cancelling skips the failure message or explosion.
    record player-bed-fail-enter-event-data {
        player: player,
        fail-reason: string,
        bed: block-pos,
        will-explode: bool,
        cancelled: bool
    }

    /// A player shears a block such as a pumpkin or a beehive (Paper `PlayerShearBlockEvent`).
    record player-shear-block-event-data {
        player: player,
        block: block-pos,
        item: item-stack,
        hand: string,
        drops: list<item-stack>,
        cancelled: bool
    }

    /// A golem or wither is built from blocks (Paper `EntityConstructEvent`).
    record entity-construct-event-data {
        entity: entity,
        blocks: list<block-pos>,
        cancelled: bool
    }

    /// An entity puts an item into a composter (Paper `EntityCompostItemEvent`).
    record entity-compost-item-event-data {
        entity: entity,
        block: block-pos,
        item: item-stack,
        will-raise-level: bool,
        cancelled: bool
    }

    /// A hopper puts an item into a composter (Paper `CompostItemEvent`).
    record compost-item-event-data {
        block: block-pos,
        item: item-stack,
        will-raise-level: bool
    }

    /// A player is teleported by an end gateway (Paper `PlayerTeleportEndGatewayEvent`).
    record player-teleport-end-gateway-event-data {
        player: player,
        from-location: position,
        to-location: position,
        gateway: block-pos,
        cancelled: bool
    }

    /// An entity is teleported by an end gateway (Paper `EntityTeleportEndGatewayEvent`).
    record entity-teleport-end-gateway-event-data {
        entity: entity,
        from-location: position,
        to-location: position,
        gateway: block-pos,
        cancelled: bool
    }

    /// A player turns a page of a book on a lectern (Paper `PlayerLecternPageChangeEvent`).
    record player-lectern-page-change-event-data {
        player: player,
        lectern: block-pos,
        book: item-stack,
        page-turn: string,
        old-page: s32,
        new-page: s32,
        cancelled: bool
    }

    /// A player puts a book on a lectern (Paper `PlayerInsertLecternBookEvent`).
    record player-insert-lectern-book-event-data {
        player: player,
        block: block-pos,
        book: item-stack,
        cancelled: bool
    }

    /// A player clicks a sign that runs a command (Paper `PlayerSignCommandPreprocessEvent`).
    record player-sign-command-preprocess-event-data {
        player: player,
        message: string,
        sign: block-pos,
        cancelled: bool
    }

    /// A spawner is about to spawn an entity (Paper `PreSpawnerSpawnEvent`).
    record pre-spawner-spawn-event-data {
        location: position,
        entity-type: string,
        spawner-location: block-pos,
        should-abort-spawn: bool,
        cancelled: bool
    }

    /// Flowing fluid washes a block away (Paper `BlockBreakBlockEvent`).
    record block-break-block-event-data {
        block: block-pos,
        source: block-pos,
        drops: list<item-stack>
    }

    /// The command tree is sent to a player (Paper `AsyncPlayerSendCommandsEvent`). Removing a root command hides it from the client.
    record async-player-send-commands-event-data {
        player: player,
        commands: list<string>
    }

    /// Structures are searched for, for example by `/locate structure` (Paper `StructuresLocateEvent`).
    record structures-locate-event-data {
        event-world: %world,
        origin: block-pos,
        structures: list<string>,
        radius: s32,
        find-unexplored: bool,
        cancelled: bool
    }

    /// The whitelist is turned on or off (Paper `WhitelistToggleEvent`).
    record whitelist-toggle-event-data {
        enabled: bool
    }

    /// A profile is added to or removed from the whitelist (Paper `WhitelistStateUpdateEvent`).
    record whitelist-state-update-event-data {
        name: string,
        uuid: string,
        status: string,
        cancelled: bool
    }

    /// A world border changes size (Paper `WorldBorderBoundsChangeEvent`).
    record world-border-bounds-change-event-data {
        event-world: %world,
        change-type: string,
        old-size: f64,
        new-size: f64,
        duration: f64,
        cancelled: bool
    }

    /// A world border moves its center (Paper `WorldBorderCenterChangeEvent`).
    record world-border-center-change-event-data {
        event-world: %world,
        old-center-x: f64,
        old-center-z: f64,
        new-center-x: f64,
        new-center-z: f64,
        cancelled: bool
    }

    /// Someone runs a command that does not exist (Paper `UnknownCommandEvent`). No message shows nothing.
    record unknown-command-event-data {
        player: option<player>,
        command-line: string,
        message: option<string>
    }

    /// A player locks or unlocks the age of an entity (Paper `PlayerToggleEntityAgeLockEvent`).
    record player-toggle-entity-age-lock-event-data {
        player: player,
        entity: entity,
        item: item-stack,
        age-locked: bool,
        cancelled: bool
    }

    /// A copper golem checks whether a container is a valid target (Paper `ItemTransportingEntityValidateTargetEvent`).
    record item-transporting-entity-validate-target-event-data {
        entity: entity,
        block: block-pos,
        allowed: bool
    }

    /// Two animals breed into an egg instead of a baby (Paper `EntityFertilizeEggEvent`).
    record entity-fertilize-egg-event-data {
        entity: entity,
        father: entity,
        breeder: option<player>,
        experience: s32,
        cancelled: bool
    }

    /// The ender dragon breathes flame (Paper `EnderDragonFlameEvent`).
    record ender-dragon-flame-event-data {
        dragon: entity,
        area-effect-cloud: entity,
        cancelled: bool
    }

    /// The ender dragon shoots a fireball (Paper `EnderDragonShootFireballEvent`).
    record ender-dragon-shoot-fireball-event-data {
        dragon: entity,
        fireball: entity,
        cancelled: bool
    }

    /// An entity is knocked back by an attack (Paper `EntityPushedByEntityAttackEvent`).
    record entity-pushed-by-entity-attack-event-data {
        entity: entity,
        pushed-by: entity,
        cause: string,
        knockback: position,
        cancelled: bool
    }

    /// A player touches an item they could pick up (Paper `PlayerAttemptPickupItemEvent`).
    record player-attempt-pickup-item-event-data {
        player: player,
        item-entity-id: s32,
        item: item-stack,
        cancelled: bool
    }

    /// An entity in a riptide spin hits another (Paper `EntityAttemptSpinAttackEvent`).
    record entity-attempt-spin-attack-event-data {
        entity: entity,
        target: entity,
        cancelled: bool
    }

    /// An entity's equipment changed (Paper `EntityEquipmentChangedEvent`).
    record entity-equipment-changed-event-data {
        entity: entity,
        slots: list<string>,
        new-items: list<item-stack>
    }

    /// An entity pushes into another (Paper `EntityCollideWithEntityEvent`).
    record entity-collide-with-entity-event-data {
        entity: entity,
        collided: entity,
        cancelled: bool
    }

    /// A tamed animal's death message is sent to its owner (Paper `TameableDeathMessageEvent`).
    record tameable-death-message-event-data {
        entity: entity,
        death-message: string,
        cancelled: bool
    }

    /// An effect ticks on an entity (Paper `EntityEffectTickEvent`).
    record entity-effect-tick-event-data {
        entity: entity,
        effect-type: string,
        amplifier: s32,
        cancelled: bool
    }

