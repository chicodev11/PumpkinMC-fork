        target-world: %world,
        cancelled: bool
    }

    record async-structure-generate-event-data {
        world-name: string,
        structure-name: string,
        pos: block-pos,
        cancelled: bool
    }

    record async-structure-spawn-event-data {
        world-name: string,
        structure-name: string,
        pos: block-pos,
        cancelled: bool
    }

    record chunk-populate-event-data {
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record chunk-unload-event-data {
        chunk-x: s32,
        chunk-z: s32,
        cancelled: bool
    }

    record entities-load-event-data {
        chunk-x: s32,
        chunk-z: s32,
        entity-count: u32,
        cancelled: bool
    }

    record entities-unload-event-data {
        chunk-x: s32,
        chunk-z: s32,
        entity-count: u32,
        cancelled: bool
    }

    record generic-game-event-data {
        event-id: string,
        pos: position,
        cancelled: bool
    }

    record loot-generate-event-data {
        loot-table: string,
        /// The generated stacks; plugins may change the list.
        items: list<item-stack>,
        cancelled: bool
    }

    record portal-create-event-data {
        pos: block-pos,
        portal-type: string,
        cancelled: bool
    }

    record structure-grow-event-data {
        pos: block-pos,
        species: string,
        bone-meal: bool,
        cancelled: bool
    }

    record time-skip-event-data {
        skip-amount: s64,
        cancelled: bool
    }

    record world-init-event-data {
        target-world: %world
    }

    record world-save-event-data {
        world-name: string,
        cancelled: bool
    }

    record inventory-open-event-data {
        player: player,
        cancelled: bool
    }

    /// How a drag spreads the cursor stack (Bukkit `DragType`).
    enum drag-type {
        /// Left button: split evenly over the slots.
        even,
        /// Right button: one item per slot.
        single,
        /// Middle button (creative): a full stack per slot.
        clone,
    }

    /// Fired once when a drag over slots ends (Bukkit `InventoryDragEvent`); drag steps do not
    /// fire `inventory-click-event`. Cancelling leaves the slots and cursor unchanged.
    record inventory-drag-event-data {
        player: player,
        /// Slots of the open screen the drag went over, in order.
        raw-slots: list<s16>,
        drag-type: drag-type,
        /// The cursor stack before the drag is applied.
        old-cursor: item-stack,
        cancelled: bool
    }

    record craft-item-event-data {
        player: player,
        recipe-id: string,
        cancelled: bool
    }

    record furnace-smelt-event-data {
        block-pos: block-pos,
        source-item: string,
        result-item: string,
        cancelled: bool
    }

    record brew-event-data {
        block-pos: block-pos,
        fuel-level: u8,
        cancelled: bool
    }

    record brewing-stand-fuel-event-data {
        block-pos: block-pos,
        fuel-power: u16,
        cancelled: bool
    }

    record furnace-burn-event-data {
        block-pos: block-pos,
        fuel-item: string,
        burn-time: u32,
        cancelled: bool
    }

    record furnace-extract-event-data {
        player: player,
        block-pos: block-pos,
        item-id: string,
        item-amount: u32,
        exp-gained: f32
    }

    record furnace-start-smelt-event-data {
        block-pos: block-pos,
        source-item: string,
        cooking-time: u32,
        cancelled: bool
    }

    record hopper-inventory-search-event-data {
        block-pos: block-pos,
        search-pos: block-pos,
        cancelled: bool
    }

    record inventory-creative-event-data {
        player: player,
        slot: s16,
        item-id: string,
        item-count: u8,
        cancelled: bool
    }

    record inventory-interact-event-data {
        player: player,
        cancelled: bool
    }

    record inventory-move-item-event-data {
        source-pos: block-pos,
        target-pos: block-pos,
        item-id: string,
        item-amount: u32,
        cancelled: bool
    }

    record inventory-pickup-item-event-data {
        block-pos: block-pos,
        item-entity-id: s32,
        item-id: string,
        cancelled: bool
    }

    record prepare-anvil-event-data {
        player: player,
        rename-text: string,
        repair-cost: u32
    }

    record prepare-grindstone-event-data {
        player: player,
        result-item: option<string>
    }

    record prepare-inventory-result-event-data {
        player: player,
        result-item: option<string>
    }

    record prepare-item-craft-event-data {
        player: player,
        recipe-id: string,
        cancelled: bool
    }

    record prepare-smithing-event-data {
        player: player,
        result-item: option<string>
    }

    record smith-item-event-data {
        player: player,
        recipe-id: string,
        cancelled: bool
    }

    record trade-select-event-data {
        player: player,
        slot-index: u8,
        cancelled: bool
    }

    /// A player takes the result of a trade, by click, shift-click (once per trade), number key,
    /// drop key or Bedrock's trade screen (Paper `PlayerPurchaseEvent` / `PlayerTradeEvent`).
    /// Cancelled: no trade happens; nothing is paid, given or counted and the screen is resent.
    /// The player's open screen is busy meanwhile: don't open or close screens in the handler,
    /// schedule that instead.
    record player-trade-event-data {
        player: player,
        /// The villager or wandering trader; none for a `player.open-merchant` screen.
        merchant-entity-id: option<s32>,
        /// The offer's index in the screen's trade list.
        offer-index: u32,
        /// The offer as it was before this trade (`uses` not counted yet).
        trade: merchant-trade,
        cancelled: bool
    }

    record vehicle-block-collision-event-data {
        vehicle-id: s32,
        block-pos: block-pos,
        cancelled: bool
    }

    record vehicle-collision-event-data {
        vehicle-id: s32,
        cancelled: bool
    }

    record vehicle-create-event-data {
        vehicle-id: s32,
        cancelled: bool
    }

    record vehicle-damage-event-data {
        vehicle-id: s32,
        damage: f32,
        attacker-id: option<s32>,
        cancelled: bool
    }

    record vehicle-destroy-event-data {
        vehicle-id: s32,
        attacker-id: option<s32>,
        cancelled: bool
    }

    record vehicle-enter-event-data {
        vehicle-id: s32,
        entered-id: s32,
        cancelled: bool
    }

    record vehicle-entity-collision-event-data {
        vehicle-id: s32,
        collided-entity-id: s32,
        cancelled: bool
    }

    record vehicle-exit-event-data {
        vehicle-id: s32,
        exited-id: s32,
        cancelled: bool
    }

    record vehicle-move-event-data {
        vehicle-id: s32,
        from-position: position,
        to-position: position,
        cancelled: bool
    }

    record vehicle-update-event-data {
        vehicle-id: s32,
        cancelled: bool
    }

    record enchantment-offer {
        cost: s32,
        enchantment-id: s32,
        enchantment-level: s32
    }

    record prepare-item-enchant-event-data {
        player: player,
        item: item-stack,
        offers: list<enchantment-offer>,
        bookshelf-count: s32,
        cancelled: bool
    }

    record enchantment-value {
        enchantment: enchantment,
        level: u32
    }

    record enchant-item-event-data {
        player: player,
        item: item-stack,
        %option: s32,
        cost: s32,
        enchantments-to-add: list<enchantment-value>,
        cancelled: bool
    }

    record lightning-strike-event-data {
        position: position,
        is-effect: bool,
        cancelled: bool
    }

