interface server {
    use player.{player, ban-player-options, ban-ip-options, server-link, known-server-link, server-link-label};
    use common.{game-mode};
    use %world.{%world, structure-rotation, structure-block};
    use text.{text-component};
    use uuid.{uuid};
    use recipe.{recipe-manager};
    use enchantments.{enchantment-manager, custom-enchantment};
    use permission.{permission, permission-level};
    use advancement.{advancement-info, advancement-definition};
    use datapack.{datapack-manager, datapack-info};

    /// The terrain generator for `create-world-with-generator`.
    variant world-generator {
        /// The world's own generator (vanilla noise unless its saved settings say otherwise).
        default,
        /// Superflat with these layers, bottom first (vanilla `flat` world type).
        flat(flat-world-settings),
        /// Nothing but air in `minecraft:the_void` (vanilla's "The Void" superflat preset,
        /// without its spawn platform).
        void,
        /// Vanilla "Amplified" (overworld only; other dimensions use their default).
        amplified,
        /// Vanilla "Large Biomes" (overworld only; other dimensions use their default).
        large-biomes,
        /// This plugin's chunk generator (`generator-id` from registering it), used from the
        /// first chunk on, spawn chunks included. Same as `set-chunk-generator` but without
        /// any chunk generated by the world's own generator first.
        plugin(u32),
        /// A plugin chunk generator that keeps parts of vanilla generation on top of the
        /// plugin's terrain.
        plugin-with-vanilla(plugin-generator-settings),
        /// Vanilla noise terrain with a host-side coordinate warp applied to the terrain
        /// shape, the biomes and the surface (overworld settings in the overworld, the
        /// dimension's own elsewhere).
        noise-warped(noise-warp),
        /// Vanilla noise terrain of the dimension with biomes from this plugin's chunk
        /// generator (`generator-id`), for this world only: right after vanilla picks a chunk's
        /// biomes, the plugin's `handle-generate-phase` gets phase `biomes` with the chunk and
        /// may replace them (`set-biome-by-name` places custom biomes). Surface rules, carvers
        /// and features then follow the plugin's biomes. Structure placement, `/locate biome`
        /// and explorer maps still read vanilla's biome source.
        noise-with-plugin-biomes(u32),
    }

    /// One command from `server.get-known-commands`.
    record known-command {
        name: string,
        aliases: list<string>,
        description: string,
        /// The plugin that registered it; none for built-in commands.
        plugin: option<string>,
        /// Usage with the argument shape, e.g. `/tp <targets> <location>`.
        usage: option<string>,
    }

    /// A plugin generator with vanilla carvers, structures or features kept.
    record plugin-generator-settings {
        /// The plugin's chunk generator.
        generator-id: u32,
        /// Run vanilla cave and canyon carvers on the plugin's terrain.
        keep-carvers: bool,
        /// Place vanilla structures (villages, strongholds, ...), with the world seed's
        /// vanilla placement; they also show up in `/locate`.
        keep-structures: bool,
        /// Run vanilla placed features (trees, ores, flowers, ...) for the biomes the plugin
        /// set, before the plugin's own `features` phase.
        keep-vanilla-features: bool,
    }

    /// How `noise-warped` bends vanilla terrain.
    variant noise-warp {
        /// Rotates the noise around a center by an angle that grows with the distance.
        spiral(spiral-warp),
    }

    /// A spiral warp: the point at distance r from the center samples the vanilla noise
    /// at the position turned by `strength` * r / 1000 radians around the center.
    record spiral-warp {
        strength: f64,
        center-x: f64,
        center-z: f64,
    }

    /// Superflat settings.
    record flat-world-settings {
        /// Layers from the bottom of the world up.
        layers: list<flat-world-layer>,
        /// The biome everywhere, default `minecraft:plains`.
        biome: option<string>,
    }

    /// One superflat layer.
    record flat-world-layer {
        /// Block id, e.g. `minecraft:grass_block`.
        block: string,
        height: u32,
    }

    /// Represents an operator entry in the ops configuration.
    record op-entry {
        uuid: uuid,
        name: string,
        level: permission-level,
        bypasses-player-limit: bool,
    }

    /// Interface for querying and managing server operators.
    resource op-manager {
        /// Checks if a player UUID is currently an operator.
        is-op: func(id: uuid) -> bool;

        /// Retrieves the operator entry for a player UUID, if present.
        get-op: func(id: uuid) -> option<op-entry>;

        /// Gets the effective permission level for a player UUID (returns zero if not op).
        get-permission-level: func(id: uuid) -> permission-level;

        /// Grants operator status to a player (online or offline) with the specified level and bypass setting.
        op-player: async func(name: string, id: uuid, level: permission-level, bypasses-player-limit: bool);

        /// Revokes operator status from a player (online or offline). Returns true if the player was previously op.
        deop-player: async func(id: uuid) -> bool;

        /// Returns a list of all operator entries on the server.
        list-ops: func() -> list<op-entry>;
    }

    /// Represents a banned player entry in the ban list.
    record banned-player-entry {
        uuid: uuid,
        name: string,
        created: string,
        source: string,
        expires: option<string>,
        reason: string,
    }

    /// Represents a banned IP entry in the IP ban list.
    record banned-ip-entry {
        ip: string,
        created: string,
        source: string,
        expires: option<string>,
        reason: string,
    }

    /// Global manager for player and IP bans.
    resource ban-manager {
        /// Checks if a player UUID is currently banned.
        is-player-banned: func(id: uuid) -> bool;

        /// Retrieves the ban entry for a player UUID, if banned.
        get-player-ban: func(id: uuid) -> option<banned-player-entry>;

        /// Bans a player by name and UUID with the specified options (works for online and offline players).
        ban-player: async func(name: string, id: uuid, options: ban-player-options);

        /// Removes a player ban by UUID. Returns true if the player was banned.
        unban-player: func(id: uuid) -> bool;

        /// Returns all currently active player bans.
        list-player-bans: func() -> list<banned-player-entry>;

        /// Checks if an IP address is currently banned.
        is-ip-banned: func(ip: string) -> bool;

        /// Retrieves the ban entry for an IP address, if banned.
        get-ip-ban: func(ip: string) -> option<banned-ip-entry>;

        /// Bans an IP address with the specified options.
        ban-ip: async func(ip: string, options: ban-ip-options);

        /// Removes an IP ban. Returns true if the IP was banned.
        unban-ip: func(ip: string) -> bool;

        /// Returns all currently active IP bans.
        list-ip-bans: func() -> list<banned-ip-entry>;
    }

    /// Represents a player entry in the server whitelist.
    record whitelist-entry {
        uuid: uuid,
        name: string,
    }

    /// Global manager for the server whitelist.
    resource whitelist-manager {
        /// Returns whether the whitelist is currently enabled.
        is-enabled: func() -> bool;

        /// Enables or disables the server whitelist. If enabled and enforce-whitelist is set, kicks non-whitelisted players.
        set-enabled: async func(enabled: bool);

        /// Checks if a player UUID is on the whitelist.
        is-whitelisted: func(id: uuid) -> bool;

        /// Adds a player to the whitelist (online or offline). Returns true if newly added.
        add-player: func(name: string, id: uuid) -> bool;

        /// Removes a player from the whitelist. Returns true if the player was on the whitelist.
        remove-player: func(id: uuid) -> bool;

        /// Returns all whitelisted player entries.
        list-entries: func() -> list<whitelist-entry>;
    }

    /// Represents the difficulty setting of a Minecraft server.
    enum difficulty {
        /// Hostile mobs do not spawn. Players regain health automatically.
        peaceful,
        /// Hostile mobs deal less damage.
        easy,
        /// Standard Minecraft difficulty.
        normal,
        /// Hostile mobs deal more damage.
        hard,
    }

    /// Represents the three main Minecraft dimensions.
    enum dimension {
        overworld,
        nether,
        end,
    }

    record sys-info {
        cpu-count: option<u32>,
        total-memory: option<u64>,
        used-memory: option<u64>,
        os-name: option<string>,
        os-version: option<string>,
        pumpkin-version: string,
    }

    /// Memory of the server process itself, in bytes.
    record process-memory {
        /// Resident memory the process uses now (RSS, the Windows working set).
        used: u64,
        /// Virtual memory the process has reserved.
        reserved: u64,
        /// Memory the process can use: the cgroup (container) limit on Linux when there is
        /// one, otherwise the computer's physical memory.
        max: u64,
    }

    variant command-sender {
        console,
        player(player),
    }

    /// One suggestion from `get-command-suggestions`.
    record command-line-suggestion {
        text: string,
        /// The tooltip as plain text, if it has one.
        tooltip: option<string>,
    }

    /// What `get-command-suggestions` offers for a command line.
    record command-line-suggestions {
        /// Byte offset in the line where the suggestions start (the argument being typed); a
        /// leading `/` counts.
        start: u32,
        suggestions: list<command-line-suggestion>,
    }

    /// Represents the global server instance.
    resource server {
        /// Returns system information (CPU, Memory, OS).
        /// Fields are returned only if the plugin has the corresponding permissions.
        get-sys-info: func() -> sys-info;

        /// This server process's memory (Paper's `Runtime` totals; `get-sys-info` is the
        /// whole computer's). None without the `sys.info` or `sys.info.ram` permission, or
        /// when the system does not report it.
        get-process-memory: func() -> option<process-memory>;

        /// The suggestions a client typing `line` (with or without the leading `/`) would get
        /// for the next or current argument, as `sender` (Paper `tabComplete`): command names,
        /// player names, plugin suggestion handlers, ... Commands `sender` may not use give none.
        get-command-suggestions: async func(sender: command-sender, line: string) -> command-line-suggestions;

        /// Returns the current difficulty level of the server.
        get-difficulty: func() -> difficulty;

        /// Sets the difficulty level of the server and broadcasts the change to all worlds.
        set-difficulty: async func(difficulty: difficulty);

        /// Returns whether the server's difficulty is locked.
        is-difficulty-locked: func() -> bool;

        /// Sets whether the server's difficulty is locked.
        set-difficulty-locked: async func(locked: bool);

        /// Returns the total number of players currently connected to the server.
        get-player-count: func() -> u32;

        /// Returns the rolling average Milliseconds Per Tick (MSPT).
        /// A value below 50.0 is required for a stable 20 TPS.
        get-mspt: func() -> f64;

        /// Returns the effective Ticks Per Second (TPS).
        /// Ideal value is 20.0.
        get-tps: func() -> f64;

        /// Returns a list of all online players across all worlds.
        get-all-players: func() -> list<player>;

        /// Searches for a player by their exact name.
        get-player-by-name: func(name: string) -> option<player>;

        /// Searches for a player by their UUID string.
        get-player-by-uuid: func(id: uuid) -> option<player>;

        /// Returns a list of all worlds on this server.
        get-all-worlds: func() -> list<%world>;

        /// Gets a world by its dimension name (e.g., "minecraft:overworld") or custom world name (e.g., "world", "arena_1").
        get-world-by-name: func(name: string) -> option<%world>;

        /// Checks if a world exists by name or dimension.
        has-world: func(name: string) -> bool;

        execute-command: async func(command: string, sender: command-sender);

        /// Paper `getCommandMap().getKnownCommands()`: every enabled command (built-in and from
        /// plugins), sorted by name, with aliases, description, owning plugin and the usage the
        /// console sees (`/give <targets> <item> [<count>]`).
        get-known-commands: func() -> list<known-command>;

        /// Gives a vanilla block state its own break hardness (none puts back vanilla's), for
        /// states a plugin uses as its blocks (note block, mushroom, tripwire states). Digging
        /// such a state is run by the server like a custom block's: the client's prediction from
        /// the vanilla hardness (instant for tripwire) is held back and undone. Same scale as
        /// vanilla (stone 1.5, -1 unbreakable). Not saved: set it on load.
        set-block-state-hardness: func(state-id: u16, hardness: option<f32>);

        /// Creates or loads a world by its name and dimension.
        /// If a world with the given name already exists, it will be returned.
        create-world: async func(name: string, dimension: dimension) -> %world;

        /// `create-world` with a chosen generator (Bukkit `WorldCreator.type`/`generatorSettings`).
        /// The choice is saved in the world folder (`pumpkin_generator.json`): after a restart,
        /// `create-world` with the same name opens it with the same generator (plugin generators
        /// only for the plugin that chose them).
        create-world-with-generator: async func(name: string, dimension: dimension, generator: world-generator) -> %world;

        /// Copies the folder of an unloaded plugin world (a dungeon or instance template) to a
        /// new plugin world, which `create-world` then opens. Needs the `fs.write.worlds`
        /// (or `fs.write.server`) permission. Errors when `from` is loaded or missing, `to`
        /// exists, or a name is not a plain folder name.
        copy-world: async func(%from: string, to: string) -> result<_, string>;

        /// Deletes the folder of an unloaded plugin world (unload it first). Needs the
        /// `fs.write.worlds` (or `fs.write.server`) permission.
        delete-world: async func(name: string) -> result<_, string>;

        /// Unloads and saves a world by its name or dimension.
        /// Returns an error if the world cannot be found, is the primary/default world, or still has players inside.
        unload-world: async func(name: string) -> result<_, string>;

        /// Saves all players, player advancements, and loaded worlds to disk.
        save-all: async func() -> result<_, string>;

        /// Returns a list of all online players in a specific world.
        get-players-in-world: func(world-ref: %world) -> list<player>;

        /// Returns the number of online players in a specific world.
        get-player-count-in-world: func(world-ref: %world) -> u32;

        /// Shows players `client-state` wherever the server has block state `server-state`,
        /// in chunks, block updates, break particles, falling blocks and block metadata (Bedrock
        /// players get the runtime id of `client-state`). The
        /// server keeps the real state for physics, drops and plugins. Use it for custom blocks
        /// on vanilla carrier states that a resource pack retextures. Returns the previous
        /// client state, or an error for an unknown state id.
        ///
        /// Chunks players already have are not resent, so set mappings before players join.
        set-client-block-state: func(server-state: u16, client-state: u16) -> result<u16, string>;

        /// Returns the block state players are shown for `server-state`.
        get-client-block-state: func(server-state: u16) -> u16;

        /// Shows `server-state` as itself again.
        reset-client-block-state: func(server-state: u16);

        /// Removes every client block state mapping.
        reset-all-client-block-states: func();

        /// Switches off the vanilla behaviour of block state `state`, for custom blocks on
        /// carrier states: neighbour shape updates keep the state, neighbour/redstone updates,
        /// scheduled and random ticks are skipped, and using or attacking it does nothing (the
        /// held item is used instead). Breaking, collision and plugin events still work.
        /// Returns whether it was not frozen yet, or an error for an unknown state id.
        freeze-block-state: func(state: u16) -> result<bool, string>;

        /// Gives block state `state` its vanilla behaviour back. Returns whether it was frozen.
        unfreeze-block-state: func(state: u16) -> bool;

        /// Whether block state `state` has its vanilla behaviour switched off.
        is-block-state-frozen: func(state: u16) -> bool;

        /// Broadcasts a system chat message to all players.
        broadcast: async func(message: string);

        /// Deletes a signed chat message from all players' chat windows using its 256-byte signature.
        delete-message-by-signature: func(signature: list<u8>);

        /// Deletes a signed chat message from all players' chat windows using its signature cache ID.
        delete-message-by-id: func(signature-id: s32);

        /// Broadcasts a tab list header and footer to all players.
        broadcast-tab-list-header-footer: func(header: text-component, footer: text-component);

        /// Looks up a player who joined this server before (the user cache, also offline) by
        /// name, case-insensitively: their UUID and exact name.
        lookup-profile-by-name: func(name: string) -> option<tuple<uuid, string>>;

        /// Looks up the last known name of a player who joined this server before (the user cache).
        lookup-profile-by-uuid: func(id: uuid) -> option<string>;

        /// Reserves `count` consecutive entity IDs and returns the first. The server never gives
        /// them to its own entities, so packet-only (client-side) entities can use them without
        /// clashing (Paper `UnsafeValues.nextEntityId`).
        reserve-entity-ids: func(count: u32) -> s32;

        /// Returns the maximum number of players allowed on the server.
        get-max-players: func() -> u32;

        /// Returns whether the server is in hardcore mode.
        is-hardcore: func() -> bool;

        /// Returns whether the server is in online mode (authenticates with Mojang).
        is-online-mode: func() -> bool;

        /// Returns the server's Message of the Day (MOTD).
        get-motd: func() -> string;

        /// Returns whether the server has a whitelist enabled.
        has-whitelist: func() -> bool;

        /// Returns whether the server allows the Nether dimension.
        get-allow-nether: func() -> bool;

        /// Returns whether the server allows the End dimension.
        get-allow-end: func() -> bool;

        /// Returns the server's maximum view distance.
        get-view-distance: func() -> u8;

        /// Returns the server's maximum simulation distance.
        get-simulation-distance: func() -> u8;

        /// Returns the server's default gamemode.
        get-default-gamemode: func() -> game-mode;

        /// Returns the spawn protection radius in blocks (0 if disabled).
        get-spawn-protection-radius: func() -> u32;

        /// Returns the port the Java Edition server is bound to.
        get-port: func() -> u16;

        /// Returns the target Minecraft version string supported by this server (e.g. `"1.21.4"`).
        get-minecraft-version: func() -> string;

        /// Returns the recipe manager to register custom recipes.
        get-recipe-manager: func() -> recipe-manager;

        /// Returns the operator manager to query or modify server operators.
        get-op-manager: func() -> op-manager;

        /// Returns the global ban manager for querying and modifying player and IP bans.
        get-ban-manager: func() -> ban-manager;

        /// Returns the global whitelist manager for querying and modifying the server whitelist.
        get-whitelist-manager: func() -> whitelist-manager;

        /// Returns detailed information about an advancement by its ID (e.g., "minecraft:story/mine_stone" or "story/mine_stone").
        get-advancement: func(id: string) -> option<advancement-info>;

        /// Returns a list of all registered advancement IDs on the server.
        get-all-advancement-ids: func() -> list<string>;

        /// Hosts a resource pack zip on the game port itself (Paper-style "from this server"):
        /// players download it with HTTP from the address and port they joined with, so no web
        /// host is needed. Returns its SHA-1, for `player.get-hosted-resource-pack-url` and
        /// the `hash` of `player.send-resource-pack`. Hosting the same bytes again is a no-op.
        host-resource-pack: func(zip: list<u8>) -> string;

        /// Stops hosting a pack by its SHA-1; returns whether it was hosted.
        unhost-resource-pack: func(sha1: string) -> bool;

        /// Adds an advancement without a datapack, or replaces one this server's plugins added.
        /// Online players get their advancement screen resent at once.
        register-advancement: func(definition: advancement-definition) -> result<_, string>;

        /// Removes a plugin advancement and the plugin advancements under it; returns the ids
        /// removed (empty when it was not a plugin advancement). Players' progress for them is
        /// dropped from memory; saved progress stays in their file until they next save.
        unregister-advancement: func(id: string) -> list<string>;

        /// Adds an entry to a synced registry, given as the vanilla datapack JSON for that
        /// registry: `trim_material` and `trim_pattern` (armor trims), `jukebox_song` (music
        /// discs; jukeboxes play it for its `length_in_seconds` and give its
        /// `comparator_output`), `painting_variant`, `banner_pattern`, `instrument`, mob
        /// variants, `worldgen/biome` (client side only), ... The id needs the plugin's own
        /// namespace. Players who join afterwards get it, so register entries while loading.
        /// Items then name it in their components (`jukebox_playable`, `trim`,
        /// `provides_trim_material`, `painting/variant`); textures and sounds come from the
        /// resource pack.
        register-registry-entry: func(registry: string, id: string, json: string) -> result<_, string>;

        /// Registers (or replaces) structure template `name` (`plugin:path`) from the bytes of
        /// a vanilla structure `.nbt` file (as saved by a structure block; gzip or not). Then
        /// `world.place-structure-template`, `/place template plugin:path` and
        /// `get-structure-template-blocks` can use it. A datapack `/reload` forgets plugin
        /// templates, so register them again from `server-load`/reload handling if needed.
        register-structure-template: func(name: string, nbt: list<u8>) -> result<_, string>;

        /// Sets (or with `none` unsets) a permission node of a player by UUID, online or
        /// offline. Saved in `permissions.json`, so it lasts across restarts (like
        /// `player.set-permission`, which uses the same store).
        set-player-permission: func(id: uuid, node: string, value: option<bool>);

        /// The permission nodes explicitly set for a player, online or offline.
        get-player-permissions: func(id: uuid) -> list<tuple<string, bool>>;

        /// Sets (or with `none` removes) a metadata value of a player (prefix, suffix, group,
        /// ...), online or offline; saved in `permissions.json`.
        set-player-meta: func(id: uuid, key: string, value: option<string>);

        /// A metadata value of a player.
        get-player-meta: func(id: uuid, key: string) -> option<string>;

        /// All metadata of a player.
        get-all-player-meta: func(id: uuid) -> list<tuple<string, string>>;

        /// The blocks template `name` places, relative to its minimum corner and after
        /// `rotation` (structure voids left out, `skip-air` drops air): for plugin generators
        /// placing it chunk by chunk.
        get-structure-template-blocks: func(name: string, rotation: structure-rotation, skip-air: bool) -> result<list<structure-block>, string>;

        /// Returns the global enchantment manager for registering and querying custom enchantments.
        get-enchantment-manager: func() -> enchantment-manager;

        /// Returns information about an enchantment by its ID (vanilla or custom).
        get-enchantment: async func(id: string) -> option<custom-enchantment>;

        /// Returns a list of all registered enchantment IDs (custom and vanilla) on the server.
        get-all-enchantment-ids: async func() -> list<string>;

        /// Returns the global datapack manager for inspecting, enabling, disabling, and reloading datapacks.
        get-datapack-manager: func() -> datapack-manager;

        /// Broadcasts custom server links to all connected players (displayed in the client Esc pause menu in 1.21+).
        set-server-links: func(links: list<server-link>);

        /// Returns every permission node registered on the server, by Pumpkin and by plugins.
        get-all-permissions: func() -> list<permission>;
    }
}
